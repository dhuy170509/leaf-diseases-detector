{
    "version": 2,
    "installCommand": "npm --prefix server install",
    "buildCommand": "npm --prefix server run build",
    "builds": [
        {
            "src": "server/dist/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend2/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/frontend2/(.*)",
            "dest": "/frontend2/$1"
        },
        {
            "src": "/frontend2/(.*)",
            "dest": "/frontend2/$1"
        },
        {
            "src": "/(.*)",
            "dest": "server/dist/index.js"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}
